# ─────────────────────────────────────────────────────────────
# CFCompanion Backend — Environment Variables
# Copy this to .env for local dev. Set these in Railway dashboard for prod.
# ─────────────────────────────────────────────────────────────

# Database (SQLite)
# Local file-based database for zero-setup
DATABASE_URL="file:./dev.db"

# Server
PORT=3000
# Set to "production" on Railway
NODE_ENV=development

# CORS — your deployed Vercel/Netlify frontend URL
# Example: https://cfcompanion.vercel.app
FRONTEND_URL="https://YOUR_FRONTEND.vercel.app"

# Codeforces API
CF_API_BASE="https://codeforces.com/api"

# Cache TTL in seconds (5 min = 300)
CF_CACHE_TTL=300

# ─── AI (Google Gemini Flash — FREE) ─────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1M tokens/day — more than enough
GEMINI_API_KEY=AIzaSyAw5-ojw8kogt0Xbw_H6SwrzBsaCc2Sl_I

# ─── Email (for contest reminders) ───────────────────────────
# Use a Gmail account + App Password (NOT your main Gmail password)
# Steps to get App Password:
#   1. myaccount.google.com → Security → 2-Step Verification → App Passwords
#   2. Create password for "Mail" on "Other device"
#   3. Paste the 16-char result below
EMAIL_USER="your_gmail@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="CFCompanion <your_gmail@gmail.com>"

# ─── AI (Google Gemini Flash — FREE) ─────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1M tokens/day
GEMINI_API_KEY="your_gemini_api_key_here"
