# ─────────────────────────────────────────────────────────────
# CFCompanion Backend — Environment Variables
# Copy this to .env for local dev. Set these in Render/Railway for production.
# ─────────────────────────────────────────────────────────────

# ─── Database (Supabase PostgreSQL) ──────────────────────────
# Get both URLs from: Supabase → Project Settings → Database → Connection String
#
# DATABASE_URL  → Use the Session Mode Pooler URL (port 5432, different host)
#   Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# DIRECT_URL    → Same as DATABASE_URL when using Session Mode Pooler
#   (Only differs if you use Transaction Mode pooler on port 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─── Server ──────────────────────────────────────────────────
PORT=30011
# Set to "production" on Render/Railway
NODE_ENV=development

# ─── CORS — Your deployed frontend URL ───────────────────────
# Example: https://cf-companion.onrender.com
FRONTEND_URL="https://YOUR_RENDER_APP.onrender.com"

# ─── Codeforces API ──────────────────────────────────────────
CF_API_BASE="https://codeforces.com/api"

# Cache TTL in seconds (5 min = 300)
CF_CACHE_TTL=300

# ─── AI Coach (OpenRouter) ────────────────────────────────────
# Get your free key at: https://openrouter.ai/keys
# Free models available — default is "openrouter/free"
OPENROUTER_API_KEY="your_openrouter_api_key_here"
# OPENROUTER_MODEL=openrouter/free

# ─── Email (for contest reminders) ───────────────────────────
# Use a Gmail account + App Password (NOT your main Gmail password)
# Steps to get App Password:
#   1. myaccount.google.com → Security → 2-Step Verification → App Passwords
#   2. Create password for "Mail" on "Other device"
#   3. Paste the 16-char result below
EMAIL_USER="your_gmail@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="CFCompanion <your_gmail@gmail.com>"
