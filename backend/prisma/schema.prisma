generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  cfHandle      String    @unique @map("cf_handle")
  email         String?   @unique
  createdAt     DateTime  @default(now()) @map("created_at")
  lastSyncedAt  DateTime? @map("last_synced_at")

  stats             UserStats?
  solvedProblems    SolvedProblem[]
  contestReminders  ContestReminder[]
  practiceSets      PracticeSet[]
  verified          Boolean  @default(false)
  verificationCode  String?  @map("verification_code")

  @@map("users")
}

model UserStats {
  id             Int     @id @default(autoincrement())
  userId         Int     @unique @map("user_id")
  currentRating  Int     @default(0) @map("current_rating")
  maxRating      Int     @default(0) @map("max_rating")
  solvedCount    Int     @default(0) @map("solved_count")
  rank           String  @default("unrated")
  // JSON stored as string: { "greedy": 42, "dp": 18, ... }
  tagBreakdown   String  @default("{}") @map("tag_breakdown")
  // JSON stored as string: [{ "date": "...", "rating": 1200 }, ...]
  ratingHistory  String  @default("[]") @map("rating_history")
  // JSON: { "800": 12, "900": 8, ... }
  ratingBreakdown String @default("{}") @map("rating_breakdown")

  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model SolvedProblem {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  contestId     Int      @map("contest_id")
  problemIndex  String   @map("problem_index")
  problemName   String   @map("problem_name")
  rating        Int?
  tags          String   @default("[]") // JSON array as string
  solvedAt      DateTime @map("solved_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contestId, problemIndex])
  @@map("solved_problems")
}

model ContestReminder {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  cfContestId     Int      @map("cf_contest_id")
  cfContestName   String   @map("cf_contest_name")
  startsAt        DateTime @map("starts_at")
  reminded        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cfContestId])
  @@map("contest_reminders")
}

// AI response cache — avoids hammering Gemini for the same profile twice
model AICache {
  id         Int      @id @default(autoincrement())
  cacheKey   String   @unique @map("cache_key")
  response   String   // full AI text response
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  @@map("ai_cache")
}

// Practice sets — saved for a user, static or virtual contest mode
model PracticeSet {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  title       String
  mode        String   @default("practice") // "practice" | "contest"
  tags        String   @default("[]")       // JSON: string[]
  problems    String   @default("[]")       // JSON: problem objects
  durationMin Int?     @map("duration_min") // for contest mode
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("practice_sets")
}

// Forum threads — scoped by tag or problem
model ForumThread {
  id          Int      @id @default(autoincrement())
  title       String
  authorHandle String  @map("author_handle")
  tag         String?  // e.g. "greedy", "dp" — null for general
  problemId   String?  @map("problem_id") // "contestId-index" if problem-specific
  isPinned    Boolean  @default(false) @map("is_pinned")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  posts  ForumPost[]

  @@map("forum_threads")
}

// Forum posts — replies within a thread
model ForumPost {
  id           Int      @id @default(autoincrement())
  threadId     Int      @map("thread_id")
  authorHandle String   @map("author_handle")
  content      String
  parentId     Int?     @map("parent_id") // null = top-level, set = reply
  upvotes      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  editedAt     DateTime? @map("edited_at")

  thread  ForumThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parent  ForumPost?   @relation("PostReplies", fields: [parentId], references: [id])
  replies ForumPost[]  @relation("PostReplies")
  upvotedBy PostUpvote[]

  @@map("forum_posts")
}

model PostUpvote {
  id          Int       @id @default(autoincrement())
  postId      Int       @map("post_id")
  userHandle  String    @map("user_handle")
  createdAt   DateTime  @default(now()) @map("created_at")

  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userHandle])
  @@map("post_upvotes")
}
