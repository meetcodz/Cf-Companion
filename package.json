{
  "name": "cf-companion",
  "version": "1.0.0",
  "description": "Professional competitive programming companion tool.",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend",
    "start": "npm start --prefix backend",
    "dev": "npm run dev --prefix backend",
    "db:generate": "npm run db:generate --prefix backend",
    "db:push": "npm run db:push --prefix backend",
    "db:studio": "npm run db:studio --prefix backend",
    "lint": "eslint \"backend/src/**/*.js\"",
    "format": "prettier --write \"backend/src/**/*.js\" \"frontend/**/*.html\" \"frontend/js/**/*.js\" \"frontend/css/**/*.css\""
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}
